# Copia este archivo a .env y rellena con los datos de tu proyecto de Supabase.
# La anon key es publica por diseno (PLAN 6): puede vivir en el repo.
# La service_role key JAMAS entra aqui ni al navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# El dominio propio. Sin el, todo vive en una sola direccion (como en desarrollo).
# Para probar los subdominios en local: VITE_DOMINIO_BASE=lux.localhost y abre
# lux.localhost:5173, entrar.lux.localhost:5173 o jadujoyas.lux.localhost:5173.
# VITE_DOMINIO_BASE=luxbyemory.com
